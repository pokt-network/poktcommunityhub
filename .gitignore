# Secrets. They come from 1Password (`op run --env-file .env.op` locally, mode-600
# env files on the host); nothing below should ever exist in a working tree.
.env
.env.*
!.env.example
!.env.op
*.env
*.pem
*.key
secrets/

# Node / pnpm
node_modules/
.pnpm-store/
*.log

# Build output
dist/
*.tsbuildinfo
.next/
next-env.d.ts

# Tests
coverage/

# Database dumps and local volumes: they hold ambassadors' Discord ids and proofs.
*.sql.gz
*.dump
pgdata/
backups/
# Anchored: unanchored, it also hid the app's own /proofs route (apps/web/app/proofs).
/proofs/

# Host-only compose settings
docker-compose.override.yml

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Claude Code local overrides
.claude/settings.local.json
