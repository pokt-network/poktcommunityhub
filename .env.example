NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres for domain queries (quests / submissions / XP).
# Prefer session-mode pooler (5432) or direct. Keep DATABASE_POOL_MAX low on free tier.
DATABASE_URL=
# DATABASE_POOL_MAX=1

# Discord OAuth is configured in Supabase Dashboard → Authentication → Providers → Discord.
# Also add this redirect in the Discord Developer Portal:
#   https://<project-ref>.supabase.co/auth/v1/callback
#
# Supabase → Authentication → URL Configuration (required for local login):
#   Site URL: your production URL (ok to leave as prod)
#   Redirect URLs (add ALL of these or local auth falls back to Site URL / live site):
#     http://localhost:3000/auth/callback
#     http://127.0.0.1:3000/auth/callback
#     http://localhost:3000/**
#     https://your-domain.com/auth/callback
#     https://your-domain.com/**

# Roles are managed in Admin → Users (DB-owned). Do not use env for admin IDs.

# Discord Bot integration for automatic & on-demand role synchronization:
# 1. Create a Bot in Discord Developer Portal (https://discord.com/developers/applications)
# 2. Under Bot, enable "Server Members Intent" if needed and copy the Bot Token.
# 3. Invite the bot to your server with the "Manage Roles" permission.
# 4. In Server Settings → Roles, move the Bot's role ABOVE the ambassador roles it will assign.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
