# Every variable the stack reads. Real values live in 1Password; locally run with
# `op run --env-file .env.op -- pnpm dev`, and on the host in the mode-600 files
# named below (never committed).

# ── .env.db (Postgres container) ──
POSTGRES_USER=community
POSTGRES_DB=community
POSTGRES_PASSWORD=

# ── .env.web (web container) ──
# Inside compose the host is `postgres`; locally use localhost.
DATABASE_URL=postgres://community:PASSWORD@postgres:5432/community
LOG_LEVEL=info

# Sign-in (phase 3). Discord application: OAuth2 redirect
# https://community.pocket.network/api/auth/callback/discord (and
# http://localhost:3000/api/auth/callback/discord for development).
# The public origin; the OAuth redirect is built from it.
AUTH_URL=https://community.pocket.network
# 32+ random characters: openssl rand -hex 32
AUTH_SECRET=
# The application's client id and secret.
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# The POKT server; sign-in requires membership.
DISCORD_GUILD_ID=
# Comma-separated Discord user ids; used only while there are no admins.
ADMIN_BOOTSTRAP_DISCORD_IDS=

# Proof screenshots (phase 4). Optional: defaults to /data/proofs, the proofs
# volume in docker-compose.yml. Set it only for `pnpm dev` outside Docker.
# PROOFS_DIR=/data/proofs
