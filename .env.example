# Every variable the stack reads. Real values live in 1Password; locally run with
# `op run --env-file .env.op -- pnpm dev`, and on the host in the mode-600 files
# named below (never committed).

# ── .env.db (Postgres container) ──
POSTGRES_USER=community
POSTGRES_DB=community
POSTGRES_PASSWORD=

# ── .env.web (web container) ──
# Inside compose the host is `postgres`; locally use localhost.
DATABASE_URL=postgres://community:PASSWORD@postgres:5432/community
LOG_LEVEL=info
